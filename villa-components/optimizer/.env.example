# Copy to .env; never commit credentials. Requires Node 22.9+ and Copilot CLI 1.0.98+.
HOST=127.0.0.1
PORT=3000
# Generate a long random secret and set the same value in the caller Strapi MCP environment.
ASSET_PIPELINE_TOKEN=
# Must be a vision-capable model available to your Copilot subscription.
COPILOT_IMAGE_MODEL=gpt-5.4-mini
COPILOT_CLI_PATH=copilot
STRAPI_REST_ENDPOINT=https://api.villawebsolutions.com/api
STRAPI_API_TOKEN=
# Separate admin MCP credential; do not substitute the public REST API token.
STRAPI_OFFICIAL_MCP_URL=https://api.villawebsolutions.com/mcp
STRAPI_OFFICIAL_MCP_TOKEN=