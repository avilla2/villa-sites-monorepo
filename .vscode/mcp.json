{
  "inputs": [
    {
      "type": "promptString",
      "id": "strapi-api-key",
      "description": "Strapi API Key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "strapi-admin-token",
      "description": "Strapi Admin Token",
      "password": true
    },
    {
      "type": "promptString",
      "id": "asset-pipeline-token",
      "description": "Asset Pipeline Token",
      "password": true
    }
  ],
  "servers": {
    "strapi": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/alexvilla/Projects/villa-sites-monorepo/villa-components/strapi-mcp/src/index.js"
      ],
      "env": {
        "STRAPI_REST_ENDPOINT": "https://api.villawebsolutions.com/api",
        // "STRAPI_REST_ENDPOINT": "http://localhost:1337/graphql",
        "STRAPI_API_TOKEN": "${input:strapi-api-key}",
        "ASSET_PIPELINE_TOKEN": "${input:asset-pipeline-token}"
      }
    },
    "strapi-mcp-official": {
      "type": "http",
      "url": "https://api.villawebsolutions.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:strapi-admin-token}"
      }
    }
  }
}
